@using EquipmentManagement.Application.CQRS.SiteSide.SelfService.Query.ReceiveFoodListReceipt
@using EquipmentManagement.Application.CQRS.SiteSide.SelfService.Query.ReceiveFoodReceipt
@using EquipmentManagement.Application.Convertors
@using EquipmentManagement.Domain.DTO.SiteSide.PcPoses
@using Microsoft.Extensions.Options
@model ReceiveFoodReceiptDto;
@inject IOptions<PcPosSettings> _pcPosSettings
@{
    ViewData["Title"] = "دریافت فیش غذا";
    Layout = "_ShafaLayout";
    decimal Price = ViewBag.MealPrice;
}

@section Styles {
    <style>

        @@media print {
            body * {
                visibility: hidden;
            }

            #receipt, #receipt * {
                visibility: visible;
            }

            #receipt {
                position: absolute;
                left: 0;
                top: 0;
                right: 0;
            }
        }

        .RBody {
            font-family: 'Tahoma', sans-serif;
            background-color: #f9f9f9;
            text-align: center;
            padding: 20px;
        }

        .receipt {
            background: white;
            width: 350px;
            margin: auto;
            padding: 20px;
            border: 1px solid #ddd;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            direction: rtl;
        }

        h2 {
            margin: 10px 0;
            border-bottom: 1px dashed #aaa;
            padding-bottom: 5px;
        }

        table {
            width: 100%;
            text-align: right;
            margin-top: 10px;
        }

            table td {
                padding: 5px;
                border-bottom: 1px solid #eee;
            }

        .total {
            font-weight: bold;
            color: #333;
        }

        .btns {
            margin-top: 20px;
            text-align: center !important;
        }
    </style>

}


<section class="bg-home bg-circle-gradiant d-flex align-items-center">
    <div class="bg-overlay bg-overlay-white"></div>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div id="RBody">
                    @if (Model != null)
                    {
                        <ul id="discussion"></ul>
                        <div class="receipt" id="receipt">

                            <h4>فیش تحویل غذا بیمارستان شفا</h4>
                            <h5>@(Model.IsDeny ? "دسترسی ندارید" : "دسترسی آزاد")</h5>
                            <hr />

                            <table>
                                <tr>
                                    <td>نام</td>
                                    <td>@Model.FirstName</td>
                                </tr>
                                <tr>
                                    <td>نام خانوادگی</td>
                                    <td>@Model.LastName</td>
                                </tr>
                                <tr>
                                    <td>موبایل</td>
                                    <td>@Model.Mobile</td>
                                </tr>

                                <tr>
                                    <td>وعده</td>
                                    <td>@ViewBag.MealType</td>
                                </tr>
                                <tr class="">
                                    <td>کدپرسنلی</td>
                                    <td>@Model.PersonnelCode</td>
                                </tr>

                                <tr class="">
                                    <td>تاریخ دریافت غذا</td>
                                    <td>@Model.CreatedDate.ToShamsi()</td>
                                </tr>

                                <tr class="">
                                    <td>ساعت دریافت</td>
                                    <td>@Model.CreatedDate.Hour.ToString("00"):@Model.CreatedDate.Minute.ToString("00")</td>
                                </tr>

                                <tr class="">
                                    <td>شماره سفارش</td>
                                    <td>@Model.LogId</td>
                                </tr>
                            </table>

                        </div>

                        <div class="btns">

                            @if (Model.IsFree)
                            {
                                <button onclick="window.print()" class="btn btn-success"> چاپ </button>

                            }
                            else
                            {
                                <button id="btnSendAmountPCStart"  class="btn btn-success"> @Price.ToString("N0") برای چاپ پرداخت کنید </button>
                            }


                            <a class="btn btn-primary" asp-action="Index" asp-area="" asp-controller="Home">بازگشت به عقب</a>

                        </div>
                    }
                    else
                    {
                        <div class="receipt" id="receipt">

                            <h5>خطایی رخ داده است - اطلاعاتی یافت نشده</h5>
                        </div>
                    }

                </div><!---->
            </div><!--end col-->
        </div><!--end row-->
    </div> <!--end container-->
</section><!--end section-->
@section Scripts {
    <script src="~/lib/pcpos/scripts/jquery-3.6.0.min.js"></script>
    <script src="~/lib/pcpos/scripts/bootstrap-3.3.7/js/bootstrap.min.js"></script>
@*     <script src="~/lib/pcpos/scripts/jquery-1.6.4.min.js"></script> *@
    <script src="~/lib/pcpos/scripts/jquery.signalr-2.4.2.min.js"></script>
    @{
        var safeIp = _pcPosSettings.Value.DefaultIp;
        var hubUrl = _pcPosSettings.Value.SignalRHubUrl;
    }

    <!-- فایل هاب SignalR -->
    <script src="@(hubUrl)/hubs"></script>

    <script type="text/javascript">
        $(function () {

            var serverMessage = '';
            var authorization = '';

            // آدرس هاب
            $.connection.hub.url = "@hubUrl";

            // اتصال به هاب
            var console = $.connection.SSP1126HUB;

            $.connection.hub.start().done(function initialize() {
                 console.log("ii");
                // ========== تنظیمات از متغیرها ==========
                var connectionType = '@(_pcPosSettings.Value.DefaultConnectionType)';
                var posIp = '@(_pcPosSettings.Value.PosDevices.First().IpAddress)';
                var posPort = '@(_pcPosSettings.Value.PosDevices.First().Port)';
                var accountType = '@(_pcPosSettings.Value.DefaultAccountType)';
                var language = '@(_pcPosSettings.Value.DefaultLanguage)';
                var purchaseId = '@(_pcPosSettings.Value.DefaultPurchaseId ?? "P001")';
                var terminalId = '@(_pcPosSettings.Value.DefaultTerminalId)';
                var amount = '@(ViewBag.MealPrice)';
                var customerName = '@(Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model?.FirstName + " " + Model?.LastName ?? "")))';

                // ========== فقط دکمه خرید ==========
                $('#btnSendAmountPCStart').click(function () {
                    console.log("ss");
                    serverMessage = '';
                    $('#discussion').empty();

                    // مقداردهی اولیه دستگاه
                    console.server.Initial(connectionType, posIp, posPort, accountType, language, '0');

                    // تاخیر 1 ثانیه برای دریافت پاسخ مقداردهی
                    setTimeout(function () {

                        if (serverMessage == '0') {

                            // بررسی نوع حساب
                            if (accountType == "0") { // Single Account
                                console.server.SendAmount1Step(
                                    amount,
                                    null,
                                    customerName,
                                    '',
                                    purchaseId,
                                    terminalId
                                );
                            } else { // Share Account
                                var amounts = '';
                                var sumAmount = 0;
                                $("#AmountList > option").each(function () {
                                    sumAmount += parseInt($(this).val());
                                    amounts += $(this).val() + ",";
                                });
                                amounts = amounts.slice(0, -1);

                                console.server.SendAmount1Step(
                                    sumAmount,
                                    amounts,
                                    customerName,
                                    '',
                                    purchaseId,
                                    terminalId
                                );
                            }

                            $('#discussion').append('<li class="text-info"><strong>لطفاً کارت را بکشید...</strong></li>');

                        } else {
                            $('#discussion').append('<li class="text-danger"><strong>✗ خطا در مقداردهی دستگاه</strong></li>');
                        }

                    }, 1000);

                });

            }).fail(function (error) {
                console.error('SignalR Connection Error:', error);
                $('#discussion').append('<li class="text-danger"><strong>✗ خطای اتصال به سرور SignalR: ' + error + '</strong></li>');
            });


            // ========== رویدادهای دریافتی از سرور ==========

            // پاسخ سیستم
            console.client.GetSystemResponse = function (message) {
                serverMessage = message;
            };

            // کارت کشیده شده
            console.client.GetCardSwiped = function (TerminalId, CardNumberHash, CardNumberMask, PurchaseTypes, Encrypted_National_Code) {
                $('#discussion').append('<li><strong dir="ltr"> Terminal ID: ' + TerminalId + '</strong>&nbsp;&nbsp</li>');
                $('#discussion').append('<li><strong dir="ltr"> CardNumber(Hashed): ' + CardNumberHash + '</strong>&nbsp;&nbsp</li>');
                $('#discussion').append('<li><strong dir="ltr"> CardNumber(Masked): ' + CardNumberMask + '</strong>&nbsp;&nbsp</li>');
                $('#discussion').append('<li><strong dir="ltr"> NationalCode(Encrypted): ' + Encrypted_National_Code + '</strong>&nbsp;&nbsp</li>');

                $('#SelectPurchase').remove();
                if (PurchaseTypes.length > 0) {
                    $("#PurchaseType").show();
                    var res = PurchaseTypes.split("*");
                    $('#PurchaseTypeItems').append('<select Id="SelectPurchase" class="form-control">');
                    for (var i = 0; i < res.length; i += 2) {
                        $('#SelectPurchase').append('<option value=' + res[i] + '>' + res[i + 1] + '</option>');
                    }
                    $('#PurchaseTypeItems').append('</select>');
                }
            };

            // پاسخ تراکنش
            console.client.GetTransactionResponse = function (TerminalId, ResponseCode, SerialId, RRN, ResponseDescription, TxnDate, Amount, CardNumberMask) {
                $('#discussion').append('<table id="TableResult" class="table table-bordered table-striped">');
                $('#TableResult').append('<thead><tr id="TableResultHeader">');
                $('#TableResult').append('</tr></thead>');
                $('#TableResult').append('<tbody><tr id="TableResultContent" class="' + (ResponseCode == '0' ? 'success' : 'danger') + '">');
                $('#TableResult').append('</tr></tbody>');
                $('#discussion').append('</table>');

                $('#TableResultHeader').append('<th align="center"> Terminal ID </th>');
                $('#TableResultHeader').append('<th align="center"> Response Code </th>');
                $('#TableResultHeader').append('<th align="center"> Serial ID </th>');
                $('#TableResultHeader').append('<th align="center"> RRN </th>');
                $('#TableResultHeader').append('<th align="center"> Response Description </th>');
                $('#TableResultHeader').append('<th align="center"> Transaction Date </th>');
                $('#TableResultHeader').append('<th align="center"> Transaction Amount </th>');
                $('#TableResultHeader').append('<th align="center"> Card Number </th>');

                $('#TableResultContent').append('<td align="center">' + TerminalId + '</td>');
                $('#TableResultContent').append('<td align="center">' + ResponseCode + '</td>');
                $('#TableResultContent').append('<td align="center">' + SerialId + '</td>');
                $('#TableResultContent').append('<td align="center">' + RRN + '</td>');
                $('#TableResultContent').append('<td align="center">' + ResponseDescription + '</td>');
                $('#TableResultContent').append('<td align="center">' + TxnDate + '</td>');
                $('#TableResultContent').append('<td align="center">' + Amount + '</td>');
                $('#TableResultContent').append('<td align="center">' + CardNumberMask + '</td>');
            };

        });
    </script>
}