@using EquipmentManagement.Domain.DTO.SiteSide.Employee
@using EquipmentManagement.Application.Extensions;
@using EquipmentManagement.Application.Convertors;
@model FilterEmployeeTransaction

@{
    ViewData["Title"] = "مدیریت تراکنش های کارمندان";
}
@section Scripts
{
}

@section breadcrumbs
{

    <li class="active">@ViewData["Title"]</li>
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-xl-3 col-lg-3">

            <div class="widget">
                <div class="widget-header bordered-bottom bordered-green">
                    <span class="widget-caption"> فیلتر  </span>
                </div>
                <div class="widget-body">
                    <div class="row">
                        <div class="basic-form">
                            <form asp-area="" asp-controller="EmployeeTransaction" asp-action="FilterEmployeeTransaction" method="get" id="filter-search">
                                <input type="hidden" asp-for="Page" />

                                <div class="form-row">
                                    <div class="form-group col-md-12">
                                        <label>نام </label>
                                        <input type="text" asp-for="EmployeeName" class="form-control" placeholder="نام  ">
                                    </div>
                                 @*    

                                    <div class="form-group col-md-12">
                                        <label>هزینه</label>
                                        <input type="text" asp-for="Price" class="form-control" placeholder="هزینه  ">
                                    </div>
 *@

                                </div>

                                <hr />

                                <div class="form-group col-md-12">
                                    <button type="submit" class="btn btn-labeled w-100 btn-palegreen">
                                        <i class="btn-label glyphicon glyphicon-filter"></i>فیلتر
                                    </button>
                                </div>

                                @if (Context.Request.QueryString.HasValue)
                                {
                                    <div class="form-group col-md-12">
                                        <a asp-action="FilterEmployeeTransaction" asp-controller="EmployeeTransaction" asp-area="" class="btn btn-labeled w-100 btn-darkorange">
                                            <i class="btn-label glyphicon glyphicon-remove"></i>حذف فیلتر
                                        </a>
                                    </div>
                                }

                            </form>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <div class="col-xs-12 col-md-12 col-lg-9">
            <div class="well with-header with-footer table-responsive">
                <div class="header bordered-azure">
                    <div class="flex-style">
                        <span>وعده ها </span>
                        <span>تعداد کل : @Model.AllEntitiesCount</span>
                    </div>
                </div>

                @if (Model != null)
                {
                    <table class="table table-hover table-bordered tc tableShowListInAdmin">

                        <thead class="tc">
                            <tr class="tc">
                                <th>
                                شماره پرسنلی
                                </th>
                                <th>
                                   نام
                                </th>
                                <th>
                                    هزینه
                                </th>
                                <th>
                                    توضیحات
                                </th>
                                <th>
                                    تاریخ ثبت
                                </th>


                                <th>
                                    امکانات
                                </th>

                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var EmployeeTransaction in Model.Entities)
                            {
                                <tr id="profile_@EmployeeTransaction.Id" remove-ajax-item="@EmployeeTransaction.Id">
                                    <td>
                                        @EmployeeTransaction.EmployeeId
                                    </td>
                                    <td>
                                        @(EmployeeTransaction.Employee.FirstName + " " + EmployeeTransaction.Employee.LastName)
                                    </td>
                                    <td>
                                        @EmployeeTransaction.Amount
                                    </td>
                                    <td>
                                        @EmployeeTransaction.Description
                                    </td>

                                    <td>
                                        @EmployeeTransaction.CreateDate.ToShamsi() - @EmployeeTransaction.CreateDate.ToShortTimeString()
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center ">
@* 
                                            <a title="ویرایش اطلاعات وعده"
                                               asp-controller="EmployeeTransaction"
                                               asp-action="EditEmployeeTransaction"
                                               asp-route-Id="@EmployeeTransaction.Id"
                                               class="btn btn-warning btn-circle btn-xs">
                                                <i class="glyphicon glyphicon-edit"></i>
                                            </a>
                                            <button onclick="DeleteAjax(@EmployeeTransaction.Id, '@Url.Action("RemoveEmployeeTransaction", "EmployeeTransaction", new { area = "", EmployeeTransactionId = EmployeeTransaction.Id })')" class="btn btn-danger btn-circle btn-xs"><i class="glyphicon glyphicon-trash"></i></button>
 *@
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <partial name="_Paging" model="@Model.GetCurrentPaging()" />
                }
                else
                {
                    <partial name="_NotFoundPartial" />
                }

            </div>
        </div>
    </div>
</div>
